    { "en": "What can you see from the plane?", "ko": "비행기에서 뭐가 보여?", "sample_en": "Clouds and the sea.", "sample_ko": "구름이랑 바다." },
    { "en": "What do you want to do in Jeju?", "ko": "제주도에서 뭐 하고 싶어?", "sample_en": "Swim in the sea!", "sample_ko": "바다에서 수영!" }
  ],
