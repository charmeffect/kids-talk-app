  "intro_ko": "의자 두 개를 앞뒤로 놓아 비행기를 만들고, 아이는 조종사, 부모는 승무원이 되어 제주도로 날아가는 역할 놀이입니다. 벨트 매는 '딸깍' 소리, 컵에 주스 따르는 시늉, 착륙할 때 '쿵' 하는 동작을 함께 해 보세요.",
  "expressions": [
    { "en": "I'm the pilot.", "ko": "내가 조종사야.", "tip": "역할 놀이를 시작할 때 '내가 ~할래'라는 뜻으로 써요. I'm the 뒤에 captain, driver, teacher를 넣어 바꿔 말해 보세요.", "who": "kid" },
    { "en": "Fasten your seatbelt.", "ko": "안전벨트 매.", "tip": "차나 비행기에 탈 때 매일 쓸 수 있어요. fasten의 t는 소리 나지 않아 '패슨 유어 싯벨트'처럼 들립니다.", "who": "both" },
    { "en": "We're landing.", "ko": "착륙하고 있어.", "tip": "땅에 내려앉는 건 landing, 떠오르는 건 taking off예요. We're는 짧게 '위어'라고 합니다.", "who": "kid" },
    { "en": "Welcome to Jeju!", "ko": "제주에 오신 걸 환영합니다!", "tip": "도착했을 때 쓰는 인사예요. Jeju 자리에 Seoul, our home 등을 넣어 놀이에 활용하세요.", "who": "both" },
    { "en": "Coming right up!", "ko": "곧 갖다 드릴게요!", "tip": "식당이나 기내에서 주문을 받고 '바로 나갑니다'라고 할 때 써요. right up이 이어져 '커밍 라이럽'처럼 들립니다.", "who": "parent" }
  ],
  "script": [
    { "who": "parent", "en": "Let's play airplane! Who wants to fly?", "ko": "비행기 놀이 하자! 누가 조종할래?" },
    { "who": "kid", "en": "Me! I'm the pilot.", "ko": "나! 내가 조종사야.", "practice": true },
    { "who": "parent", "en": "Okay, Captain. I'm the flight attendant.", "ko": "좋아요, 기장님. 저는 승무원이에요." },
    { "who": "kid", "en": "What does a flight attendant do?", "ko": "승무원은 뭐 해?" },
    { "who": "parent", "en": "I help people and keep everyone safe.", "ko": "사람들을 돕고 모두 안전하게 지켜요." },
    { "who": "kid", "en": "Fasten your seatbelt, please!", "ko": "안전벨트 매 주세요!", "practice": true },
    { "who": "parent", "en": "Click! Everyone is ready. Where are we flying?", "ko": "딸깍! 모두 준비됐어요. 어디로 가요?" },
    { "who": "kid", "en": "To Jeju Island!", "ko": "제주도로!", "practice": true },
    { "who": "parent", "en": "Great! Ready for takeoff, Captain?", "ko": "좋아요! 이륙 준비됐나요, 기장님?" },
    { "who": "kid", "en": "Here we go! Vroooom!", "ko": "출발! 부우웅!" },
    { "who": "parent", "en": "Wow, we're above the clouds!", "ko": "우와, 구름 위로 올라왔어요!" },
    { "who": "kid", "en": "Can I have some juice, please?", "ko": "주스 좀 주세요.", "practice": true },
    { "who": "parent", "en": "Coming right up! Here you go, Captain.", "ko": "바로 갖다 드릴게요! 여기 있어요, 기장님." },
    { "who": "kid", "en": "Thank you! Mmm, yummy.", "ko": "고마워요! 음, 맛있다." },
    { "who": "parent", "en": "Captain, how do you steer the plane?", "ko": "기장님, 비행기 방향은 어떻게 바꿔요?" },
    { "who": "kid", "en": "With this! Left, right!", "ko": "이걸로! 왼쪽, 오른쪽!" },
    { "who": "parent", "en": "Oh, it's getting bumpy. Is that okay?", "ko": "어, 비행기가 흔들려요. 괜찮은 거예요?" },
    { "who": "kid", "en": "It's okay. Just a little wind.", "ko": "괜찮아요. 바람이 조금 부는 거예요." },
    { "who": "parent", "en": "Phew. Are we there yet?", "ko": "휴. 아직 멀었어요?" },
    { "who": "kid", "en": "Almost! We're landing!", "ko": "거의 다 왔어요! 착륙합니다!", "practice": true },
    { "who": "parent", "en": "Everyone, keep your seatbelts on.", "ko": "여러분, 안전벨트를 계속 매고 계세요." },
    { "who": "kid", "en": "Bump! Welcome to Jeju!", "ko": "쿵! 제주에 오신 걸 환영합니다!", "practice": true },
    { "who": "parent", "en": "Thank you, Captain. That was a smooth flight!", "ko": "고마워요, 기장님. 편안한 비행이었어요!" },
    { "who": "kid", "en": "Let's fly back home tomorrow!", "ko": "내일 다시 집으로 날아가자!" }
  ],
  "talkMore": [
